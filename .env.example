# Copie para .env (ignorado pelo git) e preencha so o que for usar.
# Sem nenhuma chave a arena roda em modo demo (dados simulados).

# --- Servidor local ---------------------------------------------------------
# Escuta so em loopback. Outro valor exige ARENA_ALLOW_REMOTE=1 (nao recomendado).
ARENA_HOST=127.0.0.1
ARENA_PORT=8780
# Caminho do arquivo de provedores CLI / OpenAI-compativeis (copie de arena.config.example.json).
ARENA_CONFIG=./arena.config.json
# Opcional: carrega este arquivo no lugar do .env da raiz.
# ARENA_ENV_FILE=
# ARENA_ALLOW_REMOTE=

# --- Provedor JEV (TypeSafe API) -------------------------------------------
TYPESAFE_API_KEY=
JEV_MODEL=

# --- Provedor Cursor (opcional; exige @cursor/sdk instalado) ----------------
CURSOR_API_KEY=

# --- API compativel com OpenAI ----------------------------------------------
# O nome da variavel e o que aparece em "apiKeyEnv" no arena.config.json.
# Voce pode usar outros nomes (OPENROUTER_API_KEY, etc.) alem deste.
OPENAI_API_KEY=
